# FastAPI Configuration
API_V1_STR=/api/v1
PROJECT_NAME=Research Rover API
VERSION=2.0.0

# Data Directory
DATA_FOLDER=../data

# Model Configuration
EMBEDDING_MODEL=all-mpnet-base-v2

# Search Configuration
DEFAULT_MAX_RESULTS=10
DEFAULT_PER_PAGE=10
MAX_PER_PAGE=100

# File Configuration
MAX_FILE_SIZE=104857600  # 100MB
CHUNK_SIZE=512
CHUNK_OVERLAP=50

GOOGLE_GENAI_API_KEY="your_gemini_api_key"
EMAIL="your_email"
PUBMED_API_KEY="your_pubmed_api_key"